# ============================================================
# LAMMPS NVT 稳定性验证 — 64 H2O, 300 K
# 模型: iter-005 × 4 (model deviation)
# 阶段一: 10 ps, 阶段二: 扩展至 100 ps
#
# DATA_FILE, TEMP, STEPS, SEED, restart 由命令行 -v 传入
# ============================================================

# ---- 输出频率 ----
variable    THERMO_FREQ  equal 100    # 每 50 fs 输出热力学
variable    DUMP_FREQ    equal 200    # 每 100 fs 输出轨迹

# ---- Nose-Hoover 恒温器参数 ----
variable    TAU_T        equal 0.1    # 温度阻尼 (ps), 生产 MD 建议 0.1

# ============================================================
units           metal
atom_style      atomic
boundary        p p p

atom_modify     map yes
neighbor        1.0 bin
box             tilt large

# ---- 读入初始结构或 restart ----
if "${restart} > 0" then "read_restart md.restart.*" else "read_data ${DATA_FILE} extra/atom/types 0"

mass 1  15.999   # O
mass 2  1.008    # H

change_box all triclinic

# ---- DeepMD 插件 ----
plugin load /public/groups/benchmark/libs/conda/deepmd/3.0.0b0-cuda118/opt/deepmd/lib/libdeepmd_lmp.so

# ---- DeepMD pair style (4 模型, model deviation) ----
# DP_MODELS 由 run_nvt.sh 通过 sed 替换 @DP_MODELS@ 注入
pair_style deepmd @DP_MODELS@ out_freq ${DUMP_FREQ} out_file model_devi.out
pair_coeff * *

if "${restart} == 0" then "velocity all create ${TEMP} ${SEED}"

# ---- NVT 系综 ----
fix 1 all nvt temp ${TEMP} ${TEMP} ${TAU_T}

# ---- 热力学输出 (同时写到 log.lammps 和 thermo.dat) ----
thermo_style custom step temp pe ke etotal press vol lx ly lz xy xz yz
thermo       ${THERMO_FREQ}
log          thermo.dat

# ---- 轨迹 dump (坐标+力, 用于后续 RDF 分析) ----
dump 1 all custom ${DUMP_FREQ} dump.lammpstrj id type x y z fx fy fz

# ---- restart (每 10000 步保存) ----
restart 10000 md.restart

timestep 0.000500
run      ${N_STEPS} upto

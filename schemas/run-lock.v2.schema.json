{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccbench.ai/schemas/run-lock.v2.schema.json",
  "title": "RunLockV2",
  "description": "Immutable single-run execution lock ensuring fairness and provenance auditing.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "run_id": {
      "type": "string"
    },
    "experiment_id": {
      "type": "string"
    },
    "case": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "skill": {
      "type": "string"
    },
    "repeat": {
      "type": "integer",
      "minimum": 1
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_model_turns": { "type": "integer", "minimum": 1 },
        "max_total_tokens": { "type": "integer", "minimum": 1 },
        "agent_active_walltime_sec": { "type": "number", "minimum": 1.0 },
        "scheduler_wait_walltime_sec": { "type": "number", "minimum": 0.0 }
      },
      "required": [
        "max_model_turns",
        "max_total_tokens",
        "agent_active_walltime_sec",
        "scheduler_wait_walltime_sec"
      ],
      "additionalProperties": false
    },
    "model_identity": {
      "type": "object",
      "properties": {
        "provider": { "type": "string" },
        "requested_model": { "type": "string" },
        "resolved_model": { "type": ["string", "null"] },
        "identity_strength": {
          "type": "string",
          "enum": ["alias", "alias-only", "exact-snapshot", "pinned-digest"]
        }
      },
      "required": ["provider", "requested_model", "identity_strength"],
      "additionalProperties": false
    },
    "candidate_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "compute_profile_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "runtime_digests": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "verifier_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ccbench_commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "experiment_id",
    "case",
    "model",
    "skill",
    "repeat",
    "budget",
    "model_identity",
    "candidate_digest",
    "verifier_digest",
    "ccbench_commit"
  ],
  "additionalProperties": false
}

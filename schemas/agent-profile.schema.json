{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["runner", "command", "model", "effort", "max_turns", "max_budget_usd", "allowed_skills", "transcript_format"],
  "properties": {
    "runner": {"const": "host_claude_code"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "model": {"type": "string", "minLength": 1},
    "effort": {"enum": ["low", "medium", "high"]},
    "max_turns": {"type": "integer", "minimum": 1},
    "max_budget_usd": {"type": "number", "minimum": 0},
    "api_endpoint_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "api_key_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "allowed_skills": {"type": "array", "items": {"type": "string"}},
    "tool_policy": {"type": "string", "minLength": 1},
    "transcript_format": {"const": "jsonl"}
  },
  "additionalProperties": false
}

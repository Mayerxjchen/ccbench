{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccbench.example/schemas/compute-request-draft.schema.json",
  "title": "bench-compute-request Candidate draft",
  "type": "object",
  "required": ["schema_version", "compute_class", "command", "resources", "inputs", "outputs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "compute_class": { "enum": ["cpu", "gpu"] },
    "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "resources": { "$ref": "compute-request.schema.json#/$defs/resources" },
    "inputs": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["path"], "properties": { "path": { "type": "string", "minLength": 1 } }, "additionalProperties": false } },
    "outputs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "validation": { "type": "object" }
  }
}

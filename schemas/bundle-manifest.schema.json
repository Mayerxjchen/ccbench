{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mlip-bench.example/schemas/bundle-manifest.schema.json",
  "title": "Candidate bundle manifest",
  "description": "Allowlist packaging manifest: normalized relative paths, byte sizes, lowercase SHA-256 values, and a deterministic root digest. Files listed here are the complete candidate input set — anything absent never reaches the Candidate.",
  "type": "object",
  "required": ["case_id", "case_version", "schema_version", "files", "public_digest", "leak_scan"],
  "properties": {
    "case_id": { "type": "string" },
    "case_version": { "type": "string" },
    "schema_version": { "type": "string" },
    "public_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "leak_scan": {
      "type": "array",
      "items": { "type": "string" }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

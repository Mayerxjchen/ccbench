{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mlip-bench.example/schemas/case.schema.json",
  "title": "MLIP Scientific-Agent Benchmark case contract",
  "description": "Versioned host-Candidate case contract. Active manifests declare [execution] local_sandbox, [candidate] host_claude_code, abstract [compute] needs, and a hidden [verifier] profile.",
  "type": "object",
  "required": ["execution", "candidate"],
  "properties": {
    "execution": {
      "type": "object",
      "required": ["class"],
      "properties": {
        "class": {
          "enum": ["local_sandbox", "hpc_controller"]
        }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["instruction", "submission_root"],
      "properties": {
        "instruction": { "type": "string" },
        "submission_root": { "type": "string" },
        "legacy_submission_layout": { "type": "boolean" },
        "runner": { "const": "host_claude_code" },
        "max_agent_seconds": {
          "type": "number",
          "minimum": 1,
          "description": "Case-declared agent budget bound, only when the case needs more than the infra standard (600s)."
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "destination"],
            "properties": {
              "source": { "type": "string" },
              "destination": { "type": "string" },
              "strip_prefix": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "description": "Scientific runtime requirements declared by the case (e.g. [runtime] requirements = [{ name = \"cp2k\" }]). The harness resolves these to a concrete image via the runtime registry."
    },
    "compute": {
      "type": "object",
      "required": ["classes"],
      "properties": {
        "classes": {
          "type": "array",
          "items": { "enum": ["cpu", "gpu"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "required_capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "optional_capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "required": ["profile"],
      "properties": { "profile": { "type": "string", "minLength": 1 }, "skills": { "type": "array", "items": { "type": "string" } } },
      "additionalProperties": false
    },
    "verifier": {
      "type": "object",
      "required": ["profile"],
      "properties": {
        "profile": { "type": "string", "minLength": 1 },
        "timeout_sec": { "type": "number", "minimum": 1 },
        "env": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "hpc": {
      "type": "object",
      "required": ["contract_version", "required_capabilities"],
      "properties": {
        "contract_version": { "type": "string" },
        "required_capabilities": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        },
        "scientific_capabilities": {
          "type": "object",
          "description": "Scientific compute capabilities an HPC case must/may run. Required is fixed by the paper; optional names heavy-science choices that remain a Discovery decision. Category plugins consume these; no plugin dispatches on a case id.",
          "properties": {
            "required": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            },
            "optional": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "qualification": {
          "type": "object",
          "description": "Qualification gate (capability-matrix spec §5b). The effective gate is `declared requires` ∪ registry auto-derivation from [runtime].requirements families; the declared list is authoritative for the dispatcher tiers, which are never auto-derived. The withdrawn bare [hpc].qual_requires array is rejected.",
          "properties": {
            "requires": {
              "type": "array",
              "items": { "type": "string", "pattern": "^(dispatcher|runtime)\\.[a-z0-9-]+$" },
              "uniqueItems": true,
              "description": "Qualification capabilities the site receipt must derive PASS before this case may run formally (e.g. [\"dispatcher.gpu\", \"runtime.matclaw-gpu\"]). Names are verified against the derived matrix by case_requirements_satisfied — unknown names block, fail-closed."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "description": "Case selection and research paradigm specification (SSOT).",
      "properties": {
        "paradigm": {
          "type": "string",
          "enum": ["standard", "research_question"],
          "description": "Selection paradigm."
        },
        "hypothesis": { "type": "string" },
        "counterfactual_rationale": { "type": "string" }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "description": "Portfolio coverage dimensions for representativeness analysis. Optional — cases without coverage tags are valid but excluded from portfolio reports.",
      "properties": {
        "scientific_domain": {
          "type": "string",
          "minLength": 1,
          "description": "Material or physics system (e.g. ferroelectric_cips, water_liquid)"
        },
        "method_family": {
          "type": "string",
          "minLength": 1,
          "description": "Computational approach (e.g. active_learning_potential, end_to_end_potential)"
        },
        "material_class": {
          "type": "string",
          "minLength": 1,
          "description": "Material category (e.g. inorganic_2d, molecular_liquid)"
        },
        "computation_type": {
          "type": "string",
          "minLength": 1,
          "description": "Execution pattern (e.g. iterative_training, end_to_end_pipeline)"
        },
        "paradigm": {
          "type": "string",
          "enum": ["standard", "research_question"],
          "description": "Case paradigm. 'research_question' enables paper-identity isolation checks; 'standard' (default) allows normal DOI/provenance references."
        }
      },
      "additionalProperties": false
    },
    "submission_contract": {
      "type": "object",
      "description": "Structural pre-Verifier gate: shape checks only, never execution.",
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "type"],
            "properties": {
              "path": { "type": "string" },
              "type": { "enum": ["file", "directory"] }
            },
            "additionalProperties": false
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "type"],
            "properties": {
              "path": { "type": "string" },
              "type": { "enum": ["file", "directory"] }
            },
            "additionalProperties": false
          }
        },
        "non_empty": {
          "type": "boolean",
          "description": "Require the collected submission to contain at least one entry (shape check only, never executes)."
        },
        "files": {
          "type": "object",
          "properties": {
            "max_single_bytes": { "type": "integer", "minimum": 1 },
            "max_total_bytes": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "json_schema": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "schema"],
            "properties": {
              "path": { "type": "string" },
              "schema": { "type": "object" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "if": {
    "properties": { "execution": { "properties": { "class": { "const": "hpc_controller" } } } },
    "required": ["execution"]
  },
  "then": { "required": ["hpc"] },
  "else": { "not": { "required": ["hpc"] } }
}

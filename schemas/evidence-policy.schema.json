{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mlip-bench.example/schemas/evidence-policy.schema.json",
  "title": "Case evidence-retention policy",
  "description": "Declares which workspace files a case's verifier actually reads (scoring_required), which files are needed to reconstruct/audit the run (reproduction_required), and whether the case may finalize formal evidence. A case in construction can never finalize.",
  "type": "object",
  "required": ["schema_version", "case_id", "state", "finalization_allowed", "scoring_required", "reproduction_required"],
  "properties": {
    "schema_version": { "type": "string" },
    "case_id": { "type": "string" },
    "state": {
      "enum": ["construction", "constructed", "benchmark_valid"]
    },
    "finalization_allowed": { "type": "boolean" },
    "scoring_required": {
      "type": "array",
      "items": { "$ref": "#/$defs/policyEntry" }
    },
    "reproduction_required": {
      "type": "array",
      "items": { "$ref": "#/$defs/policyEntry" }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "state": { "const": "construction" } },
        "required": ["state"]
      },
      "then": {
        "properties": { "finalization_allowed": { "const": false } }
      }
    }
  ],
  "$defs": {
    "policyEntry": {
      "type": "object",
      "required": ["path", "role"],
      "properties": {
        "path": { "type": "string" },
        "role": {
          "enum": ["scoring_required", "reproduction_required", "operational_log", "discardable"]
        },
        "kind": {
          "enum": ["static", "glob", "ref"],
          "description": "static: path is a file; glob: pattern is restricted-glob; ref: path is a JSON path into source"
        },
        "glob": {
          "type": "string",
          "description": "restricted glob pattern (single * wildcards only) for kind=glob"
        },
        "source": {
          "type": "string",
          "description": "JSON file the ref path is resolved against (default result.json)"
        }
      },
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mlip-bench.example/schemas/compute-profile-qualification-receipt.v2.schema.json",
  "title": "bench-hpc ComputeProfile Qualification Receipt v2 (Layer 2)",
  "description": "A signed, content-addressed ComputeProfile qualification bundle. Every evidence file is materialized below evidence_root and is bound by path, digest, size, and role.",
  "type": "object",
  "required": [
    "kind",
    "schema_id",
    "compute_profile_id",
    "compute_profile_digest",
    "routes",
    "site_receipts",
    "cloud_recycling_evidence",
    "evidence_root",
    "evidence_files",
    "audit_log",
    "audit_tail_digest",
    "digest",
    "signature"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "hpc-compute-profile-qualification/v2"
    },
    "schema_id": {
      "const": "https://mlip-bench.example/schemas/compute-profile-qualification-receipt.v2.schema.json"
    },
    "compute_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "compute_profile_digest": {
      "type": "string",
      "pattern": "^(sha256:)?[0-9a-f]{64}$"
    },
    "routes": {
      "type": "object",
      "required": ["cpu", "gpu"],
      "additionalProperties": false,
      "properties": {
        "cpu": { "type": "string", "minLength": 1 },
        "gpu": { "type": "string", "minLength": 1 }
      }
    },
    "site_receipts": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "cloud_recycling_evidence": {
      "type": "object",
      "required": [
        "stock_checked",
        "instance_id",
        "image_id",
        "gpu_type",
        "task_executed",
        "fetch_verified",
        "credentials_isolated",
        "settlement_terminated",
        "active_instances_count",
        "orphan_instances_count"
      ],
      "additionalProperties": false,
      "properties": {
        "stock_checked": { "type": "boolean" },
        "instance_id": { "type": "string", "minLength": 1 },
        "image_id": { "type": "string", "minLength": 1 },
        "gpu_type": { "type": "string", "minLength": 1 },
        "gpu_vram_gb": { "type": "integer", "minimum": 1 },
        "task_executed": { "type": "boolean" },
        "fetch_verified": { "type": "boolean" },
        "credentials_isolated": { "type": "boolean" },
        "settlement_terminated": { "type": "boolean" },
        "active_instances_count": { "type": "integer", "minimum": 0 },
        "orphan_instances_count": { "type": "integer", "minimum": 0 }
      }
    },
    "evidence_root": {
      "type": "string",
      "minLength": 1
    },
    "evidence_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size", "role"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "type": "string",
            "enum": [
              "runtime_lock",
              "site_receipt",
              "artifact",
              "settlement",
              "audit_log",
              "other"
            ]
          }
        }
      }
    },
    "audit_log": {
      "type": "string",
      "minLength": 1
    },
    "audit_tail_digest": {
      "type": "string",
      "pattern": "^(sha256:)?[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "key_id", "purpose", "public_key", "signature_hex"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "type": "string", "minLength": 1 },
        "purpose": { "const": "compute-profile-qualification" },
        "public_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signature_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        }
      }
    }
  }
}

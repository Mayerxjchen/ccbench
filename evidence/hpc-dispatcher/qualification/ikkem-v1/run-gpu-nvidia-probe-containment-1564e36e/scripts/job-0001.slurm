exec /public/software/apptainer/bin/apptainer exec --cleanenv --contain --nv --bind /public/home/<site-user>/dftworld2-runs/matclaw-031/dispatcher-qual/run-gpu-nvidia-probe-containment-1564e36e/job-0001:/workspace:rw /public/home/<site-user>/dftworld2-runs/matclaw-031/runtime/matclaw-cips-2.2.11-gpu-amd64.sif /bin/bash -c 'nvidia-smi --query-gpu=name,memory.total --format=csv,noheader | awk -F'"'"', *'"'"' '"'"'{gsub(/ MiB/,"",$2); print "BENCH_GPU_DEVICE mem_mib=" $2 " name=" $1}'"'"' && echo GPU_DEVICE_OK; ( touch /workspace/.probe-write && rm /workspace/.probe-write ) && echo '"'"'BENCH_PROBE workspace_rw=pass'"'"' || exit 20;test ! -e /public/home/<site-user>/.bench-sentinel-1564e36e && echo '"'"'BENCH_PROBE home_sentinel_absent=pass'"'"' || exit 21;test ! -e /public/home/<site-user>/.bench-cred-sentinel-1564e36e && echo '"'"'BENCH_PROBE credential_sentinel_absent=pass'"'"' || exit 22;test ! -e /public/home/<site-user>/dftworld2-runs/matclaw-031/sentinel-other-run-1564e36e && echo '"'"'BENCH_PROBE other_run_dir_absent=pass'"'"' || exit 23;ls /public/home/<site-user>/dftworld2-runs >/dev/null 2>&1 && exit 26 || echo '"'"'BENCH_PROBE runs_root_not_listable=pass'"'"'; echo CONTAINMENT_OK'

[ "$actual" = "99aefeff8f457cd6b4f57e1592db511f167ab493730f970bfd7baa68993250c3" ] || { echo "SIF digest mismatch" >&2; exit 30; }
mkdir -p /public/home/<site-user>/dftworld2-runs/matclaw-031/dispatcher-qual/run-gpu-nvidia-probe-containment-1564e36e/job-0001

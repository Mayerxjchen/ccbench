{
  "schema_version": "candidate-tool-policy/v1",
  "engine": "claude-code",
  "allowed_tools": [
    "Bash",
    "GlobTool",
    "GrepTool",
    "FileRead",
    "FileEdit",
    "FileWrite",
    "DirectoryList"
  ],
  "allowed_network_destinations": [
    "host.docker.internal:host-gateway"
  ],
  "forbidden_capabilities": [
    "docker_socket_mount",
    "host_ssh_mount",
    "host_env_secret_forwarding",
    "direct_cloud_gpu_api",
    "raw_hpc_keys"
  ],
  "enforcement": "strict-fail-closed"
}

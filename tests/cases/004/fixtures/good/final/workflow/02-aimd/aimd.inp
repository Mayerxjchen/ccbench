@set proj_name water64_aimd

&GLOBAL
  PROJECT_NAME water64_aimd
  RUN_TYPE MD
  PRINT_LEVEL MEDIUM
  WALLTIME @WALLTIME@
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  #STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    CHARGE 0
    UKS F
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 30
      &OUTER_SCF
        EPS_SCF 1.0E-6
        MAX_SCF 15
      &END OUTER_SCF
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
        ENERGY_GAP 0.1
      &END OT
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &QS
      EPS_DEFAULT 1.0E-13
      EXTRAPOLATION ASPC
      EXTRAPOLATION_ORDER 2
    &END QS
    &MGRID
      CUTOFF 500
      REL_CUTOFF 60
    &END MGRID
    &XC
      &XC_FUNCTIONAL BLYP
      &END XC_FUNCTIONAL
      &XC_GRID
        XC_SMOOTH_RHO NN50
        XC_DERIV NN50_SMOOTH
      &END
      &vdW_POTENTIAL
        DISPERSION_FUNCTIONAL PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE DFTD3
          PARAMETER_FILE_NAME dftd3.dat
          REFERENCE_FUNCTIONAL BLYP
        &END PAIR_POTENTIAL
      &END vdW_POTENTIAL
    &END XC
  &END DFT

  &SUBSYS
@include coord_n_cell.inc
    &KIND O
        BASIS_SET TZV2P-GTH
        POTENTIAL GTH-BLYP-q6
    &END KIND
    &KIND H
        BASIS_SET TZV2P-GTH
        POTENTIAL GTH-BLYP-q1
    &END KIND
  &END SUBSYS
  &PRINT
    &FORCES ON
    &END FORCES
  &END PRINT
&END FORCE_EVAL

&MOTION
  &MD
    ENSEMBLE NVT
    STEPS @AIMD_STEPS@
    TIMESTEP 0.5
    TEMPERATURE 300
    &THERMOSTAT
      REGION GLOBAL
      TYPE NOSE
      &NOSE
        LENGTH 3
        YOSHIDA 3
        TIMECON 100
        MTS 2
      &END NOSE
    &END THERMOSTAT
  &END MD
  &PRINT
    &TRAJECTORY
      FORMAT XYZ
      &EACH
        MD @AIMD_TRAJ_EACH@
      &END EACH
    &END TRAJECTORY
    &VELOCITIES OFF
    &END VELOCITIES
    &FORCES
      &EACH
        MD @AIMD_TRAJ_EACH@
      &END EACH
    &END FORCES
    &CELL
      &EACH
        MD @AIMD_TRAJ_EACH@
      &END EACH
    &END CELL
    &RESTART
      BACKUP_COPIES 3
      &EACH
        MD 500
      &END EACH
    &END RESTART
  &END PRINT
&END MOTION

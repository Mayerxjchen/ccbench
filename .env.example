# Host-only Anthropic Messages-compatible connection. Never commit a real token.
# Use ANTHROPIC_API_KEY instead when the provider documents x-api-key auth.
ANTHROPIC_AUTH_TOKEN=your_api_key_here
ANTHROPIC_BASE_URL=https://api.nonelinear.com/anthropic

# Optional; smoke only. Formal runs ignore/reject this override.
BENCH_MODEL=deepseek-v4-pro

.venv
.pagent/
jobs/
runs/
.DS_Store
.vscode/
.env
__pycache__/
*.pyc
.pytest_cache/
/tmp/
*.egg-info/
.worktrees/

# CP2K restart files (regenerated during reference runs)
H2O-RESTART.wfn*

# MatClaw formal evidence bundles stay local (see evidence/matclaw/.gitignore)
/evidence/matclaw/formal/**/artifacts/
/evidence/matclaw/formal/**/workspace/

# Generated case-policy projections (F3) — regenerated by eval.py from the
# immutable CASE_POLICIES; never committed (they would drift).
/evidence/matclaw/formal/case-policy-*.json

# HPC dispatcher qualification evidence (receipt, audit chain, scheduler IDs,
# private site paths). Stays intact locally — receipt verification depends on
# the relative positions of artifacts/audit. Packaged as a standalone
# qualification artifact with SHA-256 at release time, tied to the release tag.
# site-v1/ is archived (stale pre-C5 code identity); site-v3/ is the live dir.
/evidence/hpc-dispatcher/qualification/site-v1/
/evidence/hpc-dispatcher/qualification/site-v1-archived-*/
/evidence/hpc-dispatcher/qualification/site-v3/

# Case Builder experiments isolated in dedicated worktree (.wt/case-builder-mvp-v3).
# v1/v2/v3 trees are committed audit archives (tracking overrides these
# patterns); the rules keep NEW untracked experiment debris out of status.
/experiments/case-builder-luna-v*/
# v3's frozen 908 confirmation tree + audit notes are committed evidence
# (cherry-picked from the feature branch); negate the blanket rule for them.
!/experiments/case-builder-luna-v3/

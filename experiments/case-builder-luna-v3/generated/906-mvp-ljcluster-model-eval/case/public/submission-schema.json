{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "case://public/submission-schema.json",
  "title": "Candidate submission manifest",
  "description": "Contract for manifest.json at the sealed submission root. All paths are relative to the sealed root; absolute paths, parent traversal, symlinks and hardlinks are rejected by the verifier (C-V8).",
  "type": "object",
  "required": ["schema_version", "case_id", "provenance_sources", "artifacts", "lineage", "runtime_receipts"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "provenance_sources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "role", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "role": {
            "enum": ["student_model", "teacher_model", "dataset", "labels", "checkpoint", "log", "report", "other"]
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "source": { "type": "string" },
          "frames": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["round", "action", "dataset", "model"],
        "additionalProperties": false,
        "properties": {
          "round": { "type": "integer", "minimum": 1 },
          "action": { "type": "string", "minLength": 1 },
          "dataset": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 }
        }
      }
    },
    "runtime_receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["job_id", "backend", "exit_status"],
        "additionalProperties": false,
        "properties": {
          "job_id": { "type": "string", "minLength": 1 },
          "backend": { "type": "string", "minLength": 1 },
          "exit_status": { "enum": ["0", "completed", "success"] },
          "walltime_sec": { "type": "number", "minimum": 0 }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value", "unit", "dataset"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "value": { "type": "number" },
          "unit": { "type": "string", "minLength": 1 },
          "dataset": { "type": "string", "minLength": 1 },
          "operator": { "enum": ["<", "<=", ">", ">="] }
        }
      }
    }
  }
}

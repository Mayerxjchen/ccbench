{
  "schema_version": 1,
  "category": "mlp",
  "case_kind": "model_evaluation",
  "system": {
    "chemistry": "Lennard-Jones clusters (icosahedral and decahedral)",
    "elements": ["LJ"],
    "observable": "energy_per_atom_eV",
    "units": "eV/atom",
    "descriptor_basis": {
      "cutoff_ang": 6.0,
      "features": ["n_atoms", "r_min_ang", "r_max_ang", "coord_num_mean", "e_distort"]
    }
  },
  "interfaces": {
    "evaluation_table": {
      "description": "Run the published LC-MLP v1 checkpoint over the 24-cluster descriptor table and report per-atom cohesive-energy metrics.",
      "inputs": ["public/dataset.csv", "public/config.yaml", "public/weights/lc-mlp-v1.txt"],
      "outputs": ["manifest.json"]
    }
  }
}

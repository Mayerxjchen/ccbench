{
  "schema_version": 1,
  "submission_root": "final",
  "required": {
    "manifest": "manifest.json",
    "model_family": "DeePMD",
    "target_system": "{system_id, composition, type_map}",
    "outputs": "{model_files, workflow_root, data_root, report}",
    "lineage": "{stages:[train, explore, select, label, grow, retrain]}",
    "splits": "{training, held_out:{trajectory_id, training_overlap:false}}",
    "metrics": "{force_mae_eV_per_angstrom, force_rmse_eV_per_angstrom, energy_mae_eV_per_atom}",
    "active_iterations": "integer >= 1",
    "jobs": "list of scheduler receipts with terminal state and fetched artifacts"
  },
  "stage_record": {
    "stage": "string",
    "inputs": "relative paths and hashes",
    "outputs": "relative paths and hashes",
    "job_ids": "list",
    "runtime_identity": "string",
    "status": "terminal scheduler state"
  },
  "provenance_rule": "Every training and held-out frame is traceable to a teacher output or an explicitly recorded student prediction; hidden/reference paths are forbidden."
}
